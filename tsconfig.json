{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, "types": ["vite/client", "vite-plugin-pwa/client", "webxr", "node"],
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "isolatedModules": true, "esModuleInterop": true,
    "noEmit": true, "strict": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "android", "ios", "dist"]
}
